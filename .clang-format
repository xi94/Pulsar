---
BasedOnStyle: LLVM
UseTab: AlignWithSpaces
TabWidth: 4
IndentWidth: 4
ColumnLimit: 160
AllowShortFunctionsOnASingleLine: Empty
# A guard clause whose whole body is one short statement reads better on one line than as three.
# WithoutElse rather than AllIfsAndElse: an if that has an else is a branch, not a guard, and both
# halves of one belong in braces.
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: false
AlwaysBreakTemplateDeclarations: Yes
BinPackParameters: OnePerLine
AllowAllParametersOfDeclarationOnNextLine: false
AlignAfterOpenBracket: Align
AlignConsecutiveDeclarations:
  Enabled: true
  AlignFunctionDeclarations: false
  AlignFunctionPointers: false
AlignConsecutiveAssignments:
  Enabled: true
  AlignFunctionDeclarations: false
AlignConsecutiveMacros: Consecutive
AlignConsecutiveBitFields: Consecutive
AlignTrailingComments: true
PointerAlignment: Left
ReferenceAlignment: Left
SpaceBeforeParens: ControlStatements
IndentCaseLabels: true
NamespaceIndentation: None
SortIncludes: false

BreakBeforeBraces: WebKit
BreakConstructorInitializers: BeforeComma
BreakBeforeConceptDeclarations: Always

BraceWrapping:
  AfterFunction: false
  BeforeLambdaBody: false
FixNamespaceComments: false
