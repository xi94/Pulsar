#include "core/app_identity.h"

PULSAR_APP_ICON_RESOURCE ICON "../resources/Pulsar.ico"

1 VERSIONINFO
 FILEVERSION PULSAR_VERSION_MAJOR,PULSAR_VERSION_MINOR,PULSAR_VERSION_PATCH,0
 PRODUCTVERSION PULSAR_VERSION_MAJOR,PULSAR_VERSION_MINOR,PULSAR_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", PULSAR_APP_NAME
            VALUE "FileDescription", "Pulsar Account Manager"
            VALUE "FileVersion", PULSAR_VERSION_STRING
            VALUE "InternalName", PULSAR_APP_NAME
            VALUE "OriginalFilename", PULSAR_EXE_NAME
            VALUE "ProductName", PULSAR_APP_NAME
            VALUE "ProductVersion", PULSAR_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
